          },
          "docs": "Information regarding skills in the SkyBlock game."
        },
        {
          "info": {
            "name": "Hypixel Items",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.hypixel.net/v2/resources/skyblock/items"
          },
          "docs": "Information regarding items in the SkyBlock game."
        },
        {
          "info": {
            "name": "Hypixel Election and Mayor",
