          },
          "http": {
            "method": "GET",
            "url": "https://api.hypixel.net/v2/resources/skyblock/election"
          },
          "docs": "Information regarding the current mayor and ongoing election in SkyBlock."
        },
        {
          "info": {
            "name": "Hypixel Current Bingo Event",
            "type": "http"
