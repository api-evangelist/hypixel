            ],
            "auth": {
              "type": "apikey",
              "key": "API-Key",
              "value": "{{API-Key}}",
              "placement": "header"
            }
          },
          "docs": "Bingo data for participated events of the provided player."
        },
        {
          "info": {
            "name": "Hypixel Active/Upcoming Fire Sales",
            "type": "http"
          },
          "http": {
            "method": "GET",
