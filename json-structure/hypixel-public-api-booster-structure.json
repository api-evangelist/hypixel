{
  "$schema": "https://json-structure.org/meta/core/v0/#",
  "$id": "https://raw.githubusercontent.com/api-evangelist/hypixel/refs/heads/main/json-structure/hypixel-public-api-booster-structure.json",
  "name": "Booster",
  "description": "Booster schema from Hypixel Public API",
  "type": "object",
  "properties": {
    "_id": {
      "type": "string",
      "example": "5fcbf9d9d295e80a766f3b14"
    },
    "purchaserUuid": {
      "type": "uuid",
      "example": "ad8fefaa8351454bb739a4eaa872173f"
    },
    "amount": {
      "type": "double",
      "example": 1.0
    },
    "originalLength": {
      "type": "int32",
      "example": 42
    },
    "length": {
      "type": "int32",
      "example": 42
    },
    "gameType": {
      "type": "int32",
      "example": 42
    },
    "dateActivated": {
      "type": "int64",
      "example": 1748544600000
    }
  }
}